<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ report.name }} — Trade Targets</title>
  {% set og_title = 'Trade Targets — ' + report.trades.my_team.team_name %}
  {% set og_description = 'Pick a player on another roster and see the realistic packages to acquire them — judged by what their manager would accept.' %}
  {% set og_path = '/leagues/' + report.slug + '/targets/' %}
  {% include '_meta.html.j2' %}
  <link rel="stylesheet" href="../../../style.css">
</head>
<body class="mode-dynasty">
{% set active_page = 'targets' %}
{% set nav_prefix = '../' %}
{% set root_prefix = '../../../' %}
<div class="layout">
{% include '_nav.html.j2' %}
<main class="content">
<div class="container">
  {# ---- Package list (one timeline). Mirrors packagesHtml() in targets.js. ---- #}
  {% macro _packages(packages, timeline) %}
  {% if packages %}
  <div class="target-packages">
    <div class="target-packages-label">What it takes</div>
    {% for pkg in packages %}
    <div class="target-package">
      <div class="target-package-send">
        <span class="muted small">You send</span>
        {% for p in pkg.send %}
        <span class="target-send-player {% if p.is_pick %}is-pick{% endif %}">{{ p.name }}
          {% if p.is_pick %}<span class="pos-tag pick-tag">PICK</span>{% else %}<span class="pos-tag">{{ p.position }}{% if p.team %} · {{ p.team }}{% endif %}</span>{% endif %}
          <span class="muted small">{{ p.dynasty_value | money }}</span>
        </span>
        {% endfor %}
      </div>
      <div class="target-package-meta">
        <span>Your net lineup: <span class="{{ 'good' if pkg.my_lineup_change > 0 else ('bad' if pkg.my_lineup_change < 0 else 'muted') }}">{{ pkg.my_lineup_change | signed }}</span></span>
        <span>Their lineup: <span class="{{ 'good' if pkg.their_lineup_change > 0 else ('bad' if pkg.their_lineup_change < 0 else 'muted') }}">{{ pkg.their_lineup_change | signed }}</span></span>
        <span>Value gap: <span class="{{ 'good' if pkg.my_value_delta >= 0 else 'bad' }}">{{ pkg.my_value_delta | signed }}</span></span>
      </div>
      <div class="target-package-pitch">{{ pkg.pitch }}</div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="target-tough muted small">
    No value-fair package clears their bar
    {% if timeline == 'win-now' %}as a win-now team (they won't downgrade their lineup){% elif timeline == 'rebuild' %}even as a rebuilder{% else %}as a balanced team{% endif %}.
  </div>
  {% endif %}
  {% endmacro %}

  {# ---- Full target card with timeline toggle. ---- #}
  {% macro _target_card(t) %}
  {% set inferred = t.inferred_trajectory %}
  <section class="target-card" data-target-id="{{ t.player.sleeper_id }}">
    <div class="target-header">
      <div class="target-player">
        <span class="target-name">{{ t.player.name }}</span>
        <span class="pos-tag">{{ t.player.position }}{% if t.player.team %} · {{ t.player.team }}{% endif %}</span>
        {% if t.player.injury_status %}<span class="injury Q">{{ t.player.injury_status }}</span>{% endif %}
        <span class="muted small">dyn {{ t.player.dynasty_value | money }}{% if t.player.age %} · age {{ t.player.age | round | int }}{% endif %}</span>
      </div>
      <div class="target-meta muted small">
        on <strong>{{ t.owner_team }}</strong>
        &middot; <span class="good">+{{ t.my_lineup_improvement | money }}</span> to your lineup
      </div>
    </div>
    <div class="timeline-toggle" role="tablist" aria-label="Assume their timeline">
      <span class="timeline-toggle-label">Treat them as:</span>
      {% for tl in ['win-now', 'balanced', 'rebuild'] %}
      <button type="button" data-timeline="{{ tl }}" class="{% if tl == inferred %}active{% endif %}">
        {{ tl }}{% if tl == inferred %} <span class="inferred-dot" title="Inferred from their rankings">•</span>{% endif %}
      </button>
      {% endfor %}
    </div>
    <div class="target-packages-host">
      {{ _packages(t.packages_by_timeline[inferred], inferred) }}
    </div>
  </section>
  {% endmacro %}

  <header class="page-header">
    <h1>Trade Targets — {{ report.trades.my_team.team_name }}</h1>
    <div class="tagline">
      {{ report.name }} &middot; {{ report.season }} &middot;
      Pick a player you covet, or browse the suggestions below
      <span class="muted small">&middot; Generated {{ report.generated_at }}</span>
    </div>
  </header>

  <section class="target-picker">
    <label for="target-select" class="target-picker-label">Target a player on another roster</label>
    <select id="target-select">
      <option value="">— pick a player (top 20 RB/WR, top 10 QB/TE) —</option>
      {% for group in report.trades.targets.picker %}
      <optgroup label="{{ group.position }}">
        {% for opt in group.players %}
        <option value="{{ opt.id }}">{{ opt.label }}</option>
        {% endfor %}
      </optgroup>
      {% endfor %}
    </select>
    <div id="target-result" class="target-result"></div>
  </section>

  <h2>Suggested Targets <span class="muted small">(biggest lineup upgrades)</span></h2>
  <p class="muted small">
    Ranked by how much each player would lift your dynasty optimal lineup.
    "Your net" accounts for what you give up. Packages are filtered to ones the
    partner would plausibly accept (their timeline), value parity within 20%.
  </p>
  <div id="featured-targets">
    {% for t in report.trades.targets.featured %}
    {{ _target_card(t) }}
    {% endfor %}
  </div>

  <div class="methodology">
    <h3>Methodology</h3>
    <p>
      <strong>Pickable set:</strong> the top 20 RB and WR and top 10 QB and TE
      by dynasty value across other rosters. Pick any of them above.
    </p>
    <p>
      <strong>Packages:</strong> 1–2 of your assets whose total dynasty value
      matches the target within 20%. The partner must accept (their lineup or
      asset value improves, judged by their timeline); we don't require your
      own lineup to improve, since you're paying for a player you want.
      Packages are ranked by your net outcome first, then by how clearly the
      partner benefits.
    </p>
    <p>
      <strong>Limitations:</strong> return is just the target (no balancing
      throw-in yet). Dynasty-mode targeting. Win-now teams rarely appear as
      sources — they won't downgrade their lineup for picks.
    </p>
  </div>

  <footer class="site">
    Data: <a href="https://docs.sleeper.com">Sleeper</a> &middot;
    <a href="https://fantasycalc.com">FantasyCalc</a>.
  </footer>
</div>
</main>
</div>

<script type="application/json" id="target-index">{{ report.trades.targets.index | tojson }}</script>
<script src="../../../app.js"></script>
<script src="../../../targets.js"></script>
</body>
</html>
