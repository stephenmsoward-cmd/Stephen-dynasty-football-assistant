<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ report.name }} — Draft Recommendations</title>
  {% set og_title = 'Draft Recommendations — ' + report.name %}
  {% set og_description = 'Projected rookie board at your pick slots, with team-need adjustment based on league-wide positional demand.' %}
  {% set og_path = '/leagues/' + report.slug + '/draft/' %}
  {% include '_meta.html.j2' %}
  <link rel="stylesheet" href="../../../style.css">
</head>
<body class="mode-dynasty">
<div class="container">
  <header class="site">
    <h1>Draft Recommendations</h1>
    <div class="tagline">
      {{ report.name }} &middot; {{ report.season }} rookie draft &middot;
      {{ report.draft.num_teams }} teams &middot;
      {{ report.draft.rookie_pool_size }} available prospects
    </div>
    <nav>
      <a href="../">&larr; Back to league</a>
      {% if report.trades %}&middot; <a href="../trades/">Trade ideas</a>{% endif %}
      {% if report.waivers %}&middot; <a href="../waivers/">Waiver wire</a>{% endif %}
      <span class="muted small">&middot; Generated {{ report.generated_at }}</span>
    </nav>
  </header>

  <p class="muted small" style="margin-top: 0.5rem;">
    Two projections per pick slot: <strong>Adjusted</strong> (default) factors
    league-wide positional demand into each prospect's value;
    <strong>Strict</strong> assumes every manager drafts purely by FantasyCalc
    value. Real drafts land between the two.
  </p>

  {% if report.draft.position_demand %}
  <h2>League Positional Demand</h2>
  <div class="demand-grid">
    {% for pos in ['QB', 'RB', 'WR', 'TE'] %}
    {% set d = report.draft.position_demand[pos] %}
    {% if d %}
    <div class="demand-card">
      <div>
        <div class="demand-pos">{{ pos }}</div>
        <div class="muted small">
          spread {{ d.spread_ratio }}
        </div>
      </div>
      <div class="demand-meter" title="Demand score: {{ d.demand_score }}">
        <div class="demand-meter-fill" style="width: {{ (d.demand_score * 100) | round | int }}%;"></div>
      </div>
    </div>
    {% endif %}
    {% endfor %}
  </div>
  <p class="muted small">
    The wider the bar, the steeper the value gap between top and bottom teams
    at that position — a proxy for how badly hungry teams need rookies there.
    Adjusted board values scale by up to +20% at maximum demand.
  </p>
  {% endif %}

  {% macro adjusted_prospect_row(p) %}
  <article class="prospect-row {% if p.new_to_window %}prospect-rising{% endif %}">
    <div class="prospect-rank">#{{ p.projected_rank }}</div>
    <div class="prospect-main">
      <div>
        <span class="trade-player-name">{{ p.name }}</span>
        <span class="pos-tag">{{ p.position }}{% if p.team %} · {{ p.team }}{% endif %}</span>
        {% if p.new_to_window %}<span class="rising-badge" title="Rises into this window under team-need adjustment">▲ rising</span>{% endif %}
        {% if p.injury_status %}<span class="injury Q">{{ p.injury_status }}</span>{% endif %}
      </div>
      <div class="muted small">
        {% if p.age %}age {{ p.age | round | int }} &middot; {% endif %}
        dyn <strong>{{ p.dynasty_value | money }}</strong>
        {% if p.adjusted_value and p.adjusted_value != p.dynasty_value %}
        → adjusted <strong>{{ p.adjusted_value | money }}</strong>
        <span class="muted small">({{ p.adjusted_delta | signed }})</span>
        {% endif %}
        {% if p.redraft_value %}&middot; redraft {{ p.redraft_value | money }}{% endif %}
      </div>
    </div>
  </article>
  {% endmacro %}

  {% macro strict_prospect_row(p) %}
  <article class="prospect-row {% if p.dropped_from_window %}prospect-falling{% endif %}">
    <div class="prospect-rank">#{{ p.projected_rank }}</div>
    <div class="prospect-main">
      <div>
        <span class="trade-player-name">{{ p.name }}</span>
        <span class="pos-tag">{{ p.position }}{% if p.team %} · {{ p.team }}{% endif %}</span>
        {% if p.dropped_from_window %}<span class="falling-badge" title="Drops out of this window under team-need adjustment">▼ falling</span>{% endif %}
      </div>
      <div class="muted small">
        {% if p.age %}age {{ p.age | round | int }} &middot; {% endif %}
        dyn <strong>{{ p.dynasty_value | money }}</strong>
      </div>
    </div>
  </article>
  {% endmacro %}

  {% for slot in report.draft.my_slots %}
  <section class="draft-slot">
    <header class="draft-slot-header">
      <div>
        <h2>Pick {{ slot.label }}
          <span class="muted small">— overall #{{ slot.overall }}</span>
        </h2>
        <div class="muted small">
          Round {{ slot.round }}, slot {{ slot.slot_in_round }} of {{ report.draft.num_teams }}
          {% if slot.fc_value %}
          &middot; FantasyCalc slot value <strong>{{ slot.fc_value | money }}</strong>
          {% endif %}
        </div>
      </div>
    </header>

    <div class="draft-board-cols">
      <div class="draft-board-col">
        <h3 class="draft-board-title">Adjusted for team need</h3>
        <p class="muted small">Top {{ slot.projected_adjusted | length }} after demand-weighting.</p>
        {% for p in slot.projected_adjusted %}{{ adjusted_prospect_row(p) }}{% endfor %}
      </div>
      <div class="draft-board-col">
        <h3 class="draft-board-title">Strict by FantasyCalc value</h3>
        <p class="muted small">Top {{ slot.projected_strict | length }} assuming no positional bias.</p>
        {% for p in slot.projected_strict %}{{ strict_prospect_row(p) }}{% endfor %}
      </div>
    </div>
  </section>
  {% endfor %}

  {% if report.draft.later_board %}
  <section class="draft-slot draft-later">
    <h2>Falling beyond your last pick <span class="muted small">({{ report.draft.later_board | length }})</span></h2>
    <p class="muted small">
      Adjusted-board prospects projected to go later than your latest pick.
      Useful for trade-back decisions or eyeing late-round value.
    </p>
    {% for p in report.draft.later_board %}{{ adjusted_prospect_row(p) }}{% endfor %}
  </section>
  {% endif %}

  <div class="methodology">
    <h3>Methodology</h3>
    <p>
      <strong>Rookie pool</strong>: every FantasyCalc-valued player with
      <code>years_exp = 0</code> (entering their first NFL season) who isn't
      currently on a roster in your league.
    </p>
    <p>
      <strong>Strict board</strong>: assumes every manager picks purely by
      FantasyCalc dynasty value descending. At overall pick N, rookies
      ranked #N through #N+7 are shown.
    </p>
    <p>
      <strong>Adjusted board</strong>: each prospect's value is multiplied
      by <code>1 + (4% × gap_teams_at_position) − (2% × surplus_teams_at_position)</code>.
      Rookies at heavily-demanded positions move up the board; those at
      saturated positions drift down. The result is a more realistic
      best-player-available model that accounts for the league's actual
      structure.
    </p>
    <p>
      <strong>Limitations:</strong> Doesn't model individual teams' draft
      tendencies, doesn't account for QB tiers (which often go in clusters),
      and ignores news/landing-spot effects. Still a rough estimate — use as
      a starting point, not gospel.
    </p>
  </div>

  <footer class="site">
    Data: <a href="https://docs.sleeper.com">Sleeper</a> &middot;
    <a href="https://fantasycalc.com">FantasyCalc</a>.
  </footer>
</div>
<script src="../../../app.js"></script>
</body>
</html>
