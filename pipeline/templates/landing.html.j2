<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Dynasty Tools — scouting for Sleeper dynasty leagues</title>
  {% set og_title = 'Dynasty Tools' %}
  {% set og_description = 'Best-ball standings, trade finder, acquisition targets, power rankings, waivers, and draft prep for Sleeper dynasty leagues. Grounded on live data, refreshed nightly.' %}
  {% set og_path = '/' %}
  {% include '_meta.html.j2' %}
  <link rel="stylesheet" href="style.css">
</head>
<body class="landing">
{% set example = reports[0] if reports else none %}
<div class="container">

  <section class="hero">
    <div class="hero-eyebrow">Dynasty Tools</div>
    <h1>Your dynasty league, fully scouted.</h1>
    <p class="hero-sub">
      Best-ball standings, a trade finder, acquisition targets, power rankings,
      waivers, and draft prep for Sleeper dynasty leagues — every roster broken
      down so you always know your next move.
    </p>
    <div class="hero-cta">
      {% if example %}
      <a class="btn btn-primary" href="leagues/{{ example.slug }}/">See a live example &rarr;</a>
      {% endif %}
      <a class="btn btn-secondary" href="https://github.com/stephenmsoward-cmd/Stephen-dynasty-football-assistant">View source</a>
    </div>
    <div class="trust-line">
      Grounded on live <a href="https://docs.sleeper.com">Sleeper</a> rosters and
      <a href="https://fantasycalc.com">FantasyCalc</a> trade values — no guesses,
      refreshed nightly.
    </div>
  </section>

  {% if example %}
  <h2>What you get</h2>
  <div class="feature-grid">
    <a class="feature-card" href="leagues/{{ example.slug }}/">
      <h3>Best-Ball Standings</h3>
      <p>Every roster's optimal lineup under Dynasty and Win-Now value, with rank deltas and nightly trend lines.</p>
      <span class="feature-link">Open standings &rarr;</span>
    </a>

    {% if example.rankings %}
    <a class="feature-card" href="leagues/{{ example.slug }}/rankings/">
      <h3>Roster Diagnosis</h3>
      <p>An opinionated read on each team — contender or rebuild, your strength, your soft spot, and the next move to make.</p>
      <span class="feature-link">See the read &rarr;</span>
    </a>
    {% endif %}

    {% if example.trades %}
    <a class="feature-card" href="leagues/{{ example.slug }}/trades/">
      <h3>Trade Finder</h3>
      <p>Mutually beneficial deals across the league, judged by each partner's own timeline, each with a plain-English pitch.</p>
      <span class="feature-link">Find trades &rarr;</span>
    </a>
    {% endif %}

    {% if example.trades and example.trades.targets %}
    <a class="feature-card" href="leagues/{{ example.slug }}/targets/">
      <h3>Trade Targets</h3>
      <p>Pick any player on another roster and see the realistic packages to land them — and override how their manager is judged.</p>
      <span class="feature-link">Target a player &rarr;</span>
    </a>
    {% endif %}

    {% if example.rankings %}
    <a class="feature-card" href="leagues/{{ example.slug }}/rankings/">
      <h3>Power Rankings</h3>
      <p>A composite of Dynasty value, Win-Now value, and total asset value (players + picks), with a trajectory tag per team.</p>
      <span class="feature-link">Rank the league &rarr;</span>
    </a>
    {% endif %}

    {% if example.waivers %}
    <a class="feature-card" href="leagues/{{ example.slug }}/waivers/">
      <h3>Waiver Wire</h3>
      <p>Trending free agents matched to your roster's gaps, each paired with a smart drop suggestion that protects your starters.</p>
      <span class="feature-link">Work the wire &rarr;</span>
    </a>
    {% endif %}

    {% if example.draft %}
    <a class="feature-card" href="leagues/{{ example.slug }}/draft/">
      <h3>Draft Board</h3>
      <p>Rookie boards — both a strict value board and one adjusted for league-wide positional need — tuned to your picks.</p>
      <span class="feature-link">Prep the draft &rarr;</span>
    </a>
    {% endif %}
  </div>
  {% endif %}

  <h2>Leagues</h2>
  <ul class="league-list">
    {% for r in reports %}
    <li>
      <a href="leagues/{{ r.slug }}/">{{ r.name }}</a>
      <div class="meta">
        {{ r.season }} season &middot; {{ r.total_rosters }} teams &middot; {{ r.ppr }} PPR
      </div>
    </li>
    {% endfor %}
  </ul>

  <div class="methodology">
    <h3>How it works</h3>
    <p>
      For each team in a Sleeper dynasty league, the site solves for the
      <strong>optimal starting lineup</strong> from all rostered players
      (excluding taxi and IR) under the league's actual slot configuration.
      Player values come from FantasyCalc — <strong>dynasty</strong> values
      (multi-year, age-weighted) and <strong>win-now</strong> redraft values —
      so every ranking, trade, and target is grounded on the same live numbers
      rather than a model's memory.
    </p>
    <p>
      Everything rebuilds nightly from the Sleeper and FantasyCalc APIs, so
      rosters, injuries, and values stay current through the season.
    </p>
    <h3>Add your league</h3>
    <p>
      Open a pull request adding your league ID and a slug to
      <code>leagues.yml</code>. The nightly Action builds a report at
      <code>/leagues/&lt;slug&gt;/</code>.
    </p>
  </div>

  <footer class="site">
    Data: <a href="https://docs.sleeper.com">Sleeper</a> &middot;
    <a href="https://fantasycalc.com">FantasyCalc</a>.
    Generated {{ generated_at }}.
  </footer>
</div>
</body>
</html>
