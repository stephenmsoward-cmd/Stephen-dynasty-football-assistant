{# Open Graph / Twitter meta tags partial.
   Caller sets: og_title, og_description, og_path (relative to base_url, optional).
#}
{% set _path = og_path | default('') %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Dynasty Tools">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:description" content="{{ og_description }}">
<meta property="og:image" content="{{ base_url }}/og.png">
<meta property="og:url" content="{{ base_url }}{{ _path }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title }}">
<meta name="twitter:description" content="{{ og_description }}">
<meta name="twitter:image" content="{{ base_url }}/og.png">
<meta name="description" content="{{ og_description }}">
